# ─── Dashboard Auth (frontend/app/api/auth) ──────────────────────────────────
# Username and password for the dashboard login form.
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me_strong_password

# Random secret used to sign session tokens (HMAC-SHA256 key).
# Generate with: openssl rand -hex 32
# Rotating this value invalidates all existing sessions immediately.
AUTH_SECRET=replace_with_openssl_rand_hex_32

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# URL base pública de n8n (usada por WF-007, WF-011, WF-017, WF-019 para llamarse entre sí)
# En local: http://localhost:5678
# En producción: https://tu-dominio-n8n.com
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# URL server-side de n8n usada por el frontend para llamar al webhook de envío
# (server-only — NO usar NEXT_PUBLIC_ prefix)
# En local: http://localhost:5678
# En Railway: https://tu-dominio-n8n.com
N8N_URL=http://localhost:5678

# ─── Scripts de migración ────────────────────────────────────────────────────
# migrate-workflows.mjs: API keys de n8n (Settings → API → Create an API key)
N8N_LOCAL_API_KEY=your_local_api_key_here
N8N_RAILWAY_API_KEY=your_railway_api_key_here
# URLs opcionales (el script tiene estos defaults)
# N8N_LOCAL_URL=http://localhost:5678
# N8N_RAILWAY_URL=https://n8n-production-cec3.up.railway.app

# ─── PostgreSQL (Supabase) ───────────────────────────────────────────────────
DB_POSTGRESDB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.zmrrripgysdxbjfktszd
DB_POSTGRESDB_PASSWORD=TU_PASSWORD_AQUI
DB_POSTGRESDB_SSL=true

# ─── PostgreSQL (frontend/lib/db.ts) ─────────────────────────────────────────
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.zmrrripgysdxbjfktszd
DB_PASSWORD=TU_PASSWORD_AQUI
# Pool configuration (optional, defaults shown)
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# ─── Redis ───────────────────────────────────────────────────────────────────
QUEUE_BULL_REDIS_HOST=localhost
QUEUE_BULL_REDIS_PORT=6379

# ─── Evolution API ───────────────────────────────────────────────────────────
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=TU_EVOLUTION_API_KEY_AQUI
# Secret compartido para autenticar el webhook de Evolution (enviar en header x-webhook-secret)
EVOLUTION_WEBHOOK_SECRET=TU_WEBHOOK_SECRET_AQUI
# Legacy (si usabas la API de Meta directamente — ya no se usa con Evolution)
# WHATSAPP_API_TOKEN=TU_TOKEN_AQUI
# WHATSAPP_PHONE_NUMBER_ID=TU_PHONE_ID_AQUI
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=TU_VERIFY_TOKEN_AQUI

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://zmrrripgysdxbjfktszd.supabase.co
SUPABASE_KEY=TU_ANON_KEY_AQUI

# ─── Operaciones ─────────────────────────────────────────────────────────────
# Número al que WF-017 (Daily Report) envía el reporte diario por WhatsApp
OPS_REPORT_PHONE=+5491112345678

# Slack Bot Token para alertas (WF-013, WF-017, WF-019)
# Crear en: api.slack.com/apps → Bot Token Scopes: chat:write
SLACK_BOT_TOKEN=xoxb-TU_TOKEN_AQUI

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BUCKET=whatsapp-media
