{
  "name": "WF-010b-Daily-Reset",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-480, 0],
      "id": "wf010b-n01",
      "name": "Cron – Medianoche"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/warmup_daily_reset",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 15000,
          "retryOnFail": true,
          "maxTries": 2,
          "waitBetweenTries": 5000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-260, 0],
      "id": "wf010b-n02",
      "name": "HTTP – RPC warmup_daily_reset (batch)"
    },
    {
      "parameters": {
        "jsCode": "/*\n * Loguea el resumen del reset diario en la consola de n8n.\n * La RPC retorna: { completed, incremented, executed_at }\n *   completed:   líneas que completaron su warmup hoy\n *   incremented: líneas que avanzaron al día siguiente\n */\nconst r = $input.first().json;\n\nconst lines = [\n  `[WF-010b] Reset diario ${new Date().toISOString().slice(0, 10)}`,\n  `  Completados hoy : ${r.completed   ?? 0}`,\n  `  Avanzaron día   : ${r.incremented ?? 0}`,\n  `  Ejecutado a las : ${r.executed_at ?? '-'}`\n];\n\nconsole.log(lines.join('\\n'));\n\nreturn [{ json: { ...r, summary: lines.join(' | ') } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 0],
      "id": "wf010b-n03",
      "name": "Code – Log Resumen"
    }
  ],
  "connections": {
    "Cron – Medianoche": {
      "main": [[{ "node": "HTTP – RPC warmup_daily_reset (batch)", "type": "main", "index": 0 }]]
    },
    "HTTP – RPC warmup_daily_reset (batch)": {
      "main": [[{ "node": "Code – Log Resumen", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "pinData": {},
  "tags": [
    { "name": "warmup" },
    { "name": "daily-reset" }
  ]
}
