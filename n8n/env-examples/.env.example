# ============================================
# .env.example — WhatsApp Automation Platform
# ============================================
# Copiar este archivo como .env y completar valores reales
# NUNCA commitear el .env con valores reales
# ============================================

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CAMBIAR_ESTO

# Webhook base URL (URL pública de tu instancia n8n)
WEBHOOK_URL=https://tu-n8n.dominio.com/

# Timezone
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# --- Supabase ---
SUPABASE_URL=https://XXXXX.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- WhatsApp / Evolution API ---
EVOLUTION_API_URL=https://tu-evolution.dominio.com
EVOLUTION_API_KEY=CAMBIAR_ESTO
EVOLUTION_INSTANCE_NAME=casino-prod

# --- Base de datos directa (opcional, para scripts) ---
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXXX.supabase.co:5432/postgres

# --- Proveedores de pago ---
# NOWPayments
NOWPAYMENTS_API_KEY=CAMBIAR_ESTO
NOWPAYMENTS_IPN_SECRET=CAMBIAR_ESTO

# --- KYC (si aplica) ---
SUMSUB_APP_TOKEN=CAMBIAR_ESTO
SUMSUB_SECRET_KEY=CAMBIAR_ESTO

# --- Alertas internas ---
# Canal de WhatsApp o email para alertas del sistema
ALERTS_PHONE=+54911XXXXXXXX
ALERTS_EMAIL=ops@tudominio.com

# --- Ambiente ---
NODE_ENV=development
# Valores posibles: development | staging | production
