{
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "release:validate": "node scripts/ops/release.mjs validate",
    "release:check-ci": "node scripts/ops/release.mjs check-ci",
    "backup:create": "node scripts/ops/database-backup.mjs create",
    "backup:verify-restore": "node scripts/ops/database-backup.mjs verify-restore",
    "release:prepare": "node scripts/ops/release.mjs prepare",
    "release:deploy": "node scripts/ops/release.mjs deploy",
    "migrations:status": "node scripts/ops/run-migrations.mjs --status",
    "migrations:check": "node scripts/ops/run-migrations.mjs --check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "p-limit": "^3.1.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "playwright": "^1.59.1",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/casino-connectors/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "text-summary"
    ]
  }
}
