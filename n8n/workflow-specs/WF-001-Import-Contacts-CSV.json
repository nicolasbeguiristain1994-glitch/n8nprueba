    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst normalized = [];\n\nfor (const item of items) {\n  let phone = item.json.phone || item.json.telefono || item.json.Phone || '';\n  \n  // Limpiar caracteres no numéricos\n  phone = phone.replace(/\\D/g, '');\n  \n  // Agregar código de Argentina si no tiene\n  if (phone.length === 10) phone = '54' + phone;\n  if (phone.length === 8) phone = '5411' + phone;\n  \n  // Formato E.164\n  if (!phone.startsWith('+')) phone = '+' + phone;\n  \n  normalized.push({\n    json: {\n      phone,\n      name: item.json.name || item.json.nombre || '',\n      email: item.json.email || '',\n      tags: item.json.tags || ''\n    }\n  });\n}\n\nreturn normalized;"
      },
