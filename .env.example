# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Template only. No real secrets.
# Copy to frontend/.env.local for local development.
# Production/staging values live in Railway service variables.
# See docs/environment.md for full variable reference.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Auth ────────────────────────────────────────────────────────────────────
# Dashboard login credentials and session signing key.
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_USERNAME=admin@example.com
AUTH_PASSWORD=replace-me
AUTH_SECRET=replace-with-openssl-rand-hex-32

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Logging (casino connectors + sync script) ───────────────────────────────
# Levels: trace | debug | info | warn | error | fatal | silent
# Default: info (production) | silent (NODE_ENV=test)
LOG_LEVEL=info

# ─── PostgreSQL (frontend/lib/db.ts — API routes) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_platform
DB_USER=postgres
DB_PASSWORD=replace-me
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# SSL configuration for the frontend DB pool (frontend/lib/db.ts)
# DB_SSL=false                  → disable SSL entirely (e.g. local dev without SSL)
# DB_SSL=true (default)         → enable SSL with rejectUnauthorized=false (Supabase/Railway compatible)
# DB_SSL_REJECT_UNAUTHORIZED=true → strict certificate validation (for hardened prod setups)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ─── PostgreSQL (scripts/ops/run-migrations.mjs) ─────────────────────────────
# Note: migration runner uses a different prefix (DB_POSTGRESDB_*)
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=whatsapp_platform
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=replace-me
DB_POSTGRESDB_SSL=false

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Server-side URL for webhook calls from the frontend API routes.
# Local: http://localhost:5678
# Production: https://your-n8n-domain.com
N8N_URL=http://localhost:5678

# n8n API keys (used by scripts/ops/migrate-workflows.mjs)
N8N_LOCAL_API_KEY=replace-me
N8N_RAILWAY_API_KEY=replace-me

# ─── Cron (fase 4 — sync casino programado + recompute de prioridades) ───────
# CRON_SECRET protege DOS endpoints server-side, comparado con
# timingSafeEqual (nunca `===`):
#   POST /api/cron/casino-sync              (header x-cron-secret) — dispara
#     scripts/pipeline-diario.js (4 plataformas) cada 15 min, ver
#     n8n/workflow-specs/WF-030-Casino-Daily-Sync.json. Es el ÚNICO disparador
#     programado del sync de casino — POST /api/dashboard/casino/sync queda
#     reservado para el botón manual del dashboard (una plataforma, bajo
#     demanda); ambos comparten el mismo advisory lock por plataforma.
#   POST /api/contacts/recompute-priorities (header x-cron-secret) — ya
#     existía antes de fase 4, sin cambios.
# CRON_SECRET=replace-me
#
# CASINO_CRON_SECRET es una env var de la INSTANCIA DE N8N (no del server):
# debe configurarse ahí con el mismo valor que CRON_SECRET arriba, para que
# el workflow WF-030 lo mande en el header x-cron-secret.
#
# CRON_APP_URL: usado por scripts/pipeline-diario.js (paso de recompute de
# prioridades) cuando se corre manualmente fuera de un endpoint HTTP — URL
# pública de la app (ej: https://xxx.up.railway.app). Sin esto, ese paso se
# omite (no falla el pipeline).
# CRON_APP_URL=replace-me

# ─── Zeus API ────────────────────────────────────────────────────────────────
ZEUS_API_KEY=replace-me
ZEUS_PLAYER_TOKEN=replace-me
ZEUS_API_BASE=https://local-admin2.zeuscasino.fun   # opcional — sobreescribe config.baseUrl

# ─── Bet30 API ────────────────────────────────────────────────────────────────
# Skin de Zeus con distinta base URL. Ver src/config/platforms.config.json.
BET30_API_KEY=replace-me
BET30_PLAYER_TOKEN=replace-me
BET30_API_BASE=https://local-admin2.bet30.world     # opcional — sobreescribe config.baseUrl

# Auto-login (preferido sobre el token estático de arriba, mismo *_API_KEY):
# ZEUS_ADMIN_USER=replace-me
# ZEUS_ADMIN_PASSWORD=replace-me
# ZEUS_LOGIN_CLIENT_ID=replace-me
# ZEUS_LOGIN_CLIENT_SECRET=replace-me
# BET30_ADMIN_USER=replace-me
# BET30_ADMIN_PASSWORD=replace-me
# BET30_LOGIN_CLIENT_ID=replace-me
# BET30_LOGIN_CLIENT_SECRET=replace-me

# ─── Argenbet API (fase 2 — ArgenBetConnector implementado) ─────────────────
# Bearer JWT, no X-Api-Key (a diferencia de Zeus/Bet30). Solo 3 agentes
# permitidos: adminbtc/adminzeus/adminroyal (hardcodeados en
# ArgenBetConnector, no configurables desde acá).
# ARGENBET_PLAYER_TOKEN: token estático temporal — se vence seguido (JWT
# corto) y hoy se rota a mano. El login automático real es un TODO explícito:
# el endpoint todavía no está confirmado (ver ArgenBetConnector.authenticate()
# y docs/PLAN-METRICAS-4-PLATAFORMAS.md H10/§3) — no inventar su contrato.
# ARGENBET_ADMIN_USER/PASSWORD (fase 4): ArgenBetConnector.authenticate() ya
# las lee y se las pasa a un loginAdapter inyectado como
# { loginUrl, credentials: { user, password } } — pero sin un loginAdapter
# real conectado (el endpoint de login sigue sin confirmar), estas variables
# no tienen efecto por sí solas todavía.
# ARGENBET_API_BASE es opcional (override de baseUrl, por defecto
# https://admin.argenbet.net).
# ARGENBET_PLAYER_TOKEN=replace-me
# ARGENBET_ADMIN_USER=replace-me
# ARGENBET_ADMIN_PASSWORD=replace-me
# ARGENBET_API_BASE=replace-me

# ─── Ganamos API (fase 3 — GanamosConnector implementado) ───────────────────
# Una sesión (cookie) por agente, no un token de plataforma: el endpoint solo
# devuelve el historial completo de la cuenta cuya sesión hace el request
# (nunca desde una sesión de administrador común). Agentes confirmados:
# adminbtc, adminzeus, adminroyal, admbigwin, amdfarabet, adminimperio (ver
# frontend/lib/casino-agents.ts PLATFORM_AGENTS.ganamos).
#
# El endpoint de login real todavía NO está capturado (TODO explícito en
# GanamosConnector._loginAgent() — no inventar su contrato: falta loginUrl,
# método, body y cómo viaja la cookie de vuelta). Con USER/PASSWORD
# configurados pero sin un loginAdapter inyectado (hoy no hay ninguno en
# producción), ese agente falla de forma visible al sincronizar — los demás
# agentes configurados no se ven afectados.
#
# GANAMOS_<AGENTE>_SESSION_COOKIE es un atajo SOLO para desarrollo local: una
# cookie de sesión capturada a mano desde una pestaña ya logueada como ese
# agente (DevTools → Network → cualquier request a /api/agent_admin/... →
# header Cookie). Se vence como cualquier sesión de navegador y hay que
# volver a capturarla; nunca commitear un valor real. Si está seteada, tiene
# prioridad sobre USER/PASSWORD y evita el login por completo.
# GANAMOS_ADMINBTC_USER=replace-me
# GANAMOS_ADMINBTC_PASSWORD=replace-me
# GANAMOS_ADMINBTC_SESSION_COOKIE=replace-me
# GANAMOS_ADMINZEUS_USER=replace-me
# GANAMOS_ADMINZEUS_PASSWORD=replace-me
# GANAMOS_ADMINZEUS_SESSION_COOKIE=replace-me
# GANAMOS_ADMINROYAL_USER=replace-me
# GANAMOS_ADMINROYAL_PASSWORD=replace-me
# GANAMOS_ADMINROYAL_SESSION_COOKIE=replace-me
# GANAMOS_ADMBIGWIN_USER=replace-me
# GANAMOS_ADMBIGWIN_PASSWORD=replace-me
# GANAMOS_ADMBIGWIN_SESSION_COOKIE=replace-me
# GANAMOS_AMDFARABET_USER=replace-me
# GANAMOS_AMDFARABET_PASSWORD=replace-me
# GANAMOS_AMDFARABET_SESSION_COOKIE=replace-me
# GANAMOS_ADMINIMPERIO_USER=replace-me
# GANAMOS_ADMINIMPERIO_PASSWORD=replace-me
# GANAMOS_ADMINIMPERIO_SESSION_COOKIE=replace-me
# GANAMOS_API_BASE=replace-me

# ─── Evolution API ───────────────────────────────────────────────────────────
# Base URL of your Evolution API instance.
EVOLUTION_URL=http://localhost:8080

# Per-instance API key for sending messages.
EVOLUTION_API_KEY=replace-me

# Global API key — used to create new Evolution instances from the dashboard.
EVOLUTION_GLOBAL_API_KEY=replace-me

# Shared secret validated in x-webhook-secret header on incoming webhooks.
# Generate with: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# URL of the Evolution Manager panel (shown in the "Open Manager" button).
# This is NEXT_PUBLIC_ so it is visible to the browser — do not put secrets here.
# Production: https://evolution-api-production-xxxx.up.railway.app/manager
NEXT_PUBLIC_EVOLUTION_MANAGER_URL=http://localhost:8080/manager

# ─── Meta / WhatsApp Cloud API ───────────────────────────────────────────────
#
# Dónde obtener cada valor:
#   developers.facebook.com → tu App → WhatsApp → API Setup
#
# META_APP_ID
#   El App ID numérico de tu Meta App.
#   Ubicación: developers.facebook.com → tu App → Dashboard (esquina superior izquierda).
#   También visible en: Settings → Basic → App ID.
#   Usado en: intercambio de OAuth code, generación de long-lived token, Embedded Signup del browser.
META_APP_ID=replace-me

# META_APP_SECRET
#   Secret de tu Meta App. NUNCA exponerlo al browser.
#   Ubicación: developers.facebook.com → tu App → Settings → Basic → App Secret (click "Show").
#   Usado en: validación de firma HMAC-SHA256 de webhooks, generación de long-lived token.
META_APP_SECRET=replace-me

# META_WEBHOOK_VERIFY_TOKEN
#   Token arbitrario que elegís vos. Meta lo envía en el GET de verificación del webhook.
#   Debe coincidir exactamente con el valor configurado en:
#   developers.facebook.com → tu App → WhatsApp → Configuration → Webhook → Verify Token.
#   Generá uno con: openssl rand -hex 20
META_WEBHOOK_VERIFY_TOKEN=replace-with-openssl-rand-hex-20

# TOKEN_ENCRYPTION_KEY
#   Clave simétrica para encriptar tokens de acceso en la base de datos (AES-256 via pgcrypto).
#   Debe tener al menos 32 caracteres. NUNCA cambiarla sin ejecutar el script de rotación.
#   Rotación: node scripts/ops/rotate-token-key.ts (lee con KEY_OLD, escribe con KEY_NEW).
#   Generá una con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# NEXT_PUBLIC_META_APP_ID
#   El mismo App ID pero expuesto al browser (prefijo NEXT_PUBLIC_).
#   Necesario para inicializar el Facebook SDK en el flujo de Embedded Signup (onboarding de números).
#   Puede ser el mismo valor que META_APP_ID — es seguro exponerlo al cliente.
NEXT_PUBLIC_META_APP_ID=replace-me

# NEXT_PUBLIC_META_CONFIG_ID
#   ID de la configuración de Embedded Signup creada en tu Meta App.
#   Ubicación: developers.facebook.com → tu App → WhatsApp → Embedded Signup → crear/seleccionar configuración.
#   Es el `config_id` que se pasa a FB.login() en el frontend.
NEXT_PUBLIC_META_CONFIG_ID=replace-me

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-me

# ─── Ops / Reporting ─────────────────────────────────────────────────────────
# Phone number for daily report delivery (WF-017).
OPS_REPORT_PHONE=+5491112345678

# Slack bot token for alerts (WF-013, WF-017, WF-019).
# Create at: api.slack.com/apps → Bot Token Scopes: chat:write
SLACK_BOT_TOKEN=xoxb-replace-me

# ─── Redis ───────────────────────────────────────────────────────────────────
# REDIS_URL es la variable principal usada por:
#   - Rate limiter de Cloud API (lib/cloud-api/rate-limiter.ts) — Token Bucket 20 msg/s
#   - Cola de mensajes BullMQ (lib/cloud-api/message-queue.ts) — envíos masivos de campañas
#   - Worker cloud-message-worker.ts
# Formato: redis://[:password@]host:port[/db]
# En Railway: agregar el plugin Redis y copiar la variable REDIS_URL que genera automáticamente.
REDIS_URL=redis://localhost:6379

# Variables legacy usadas por BullMQ en otros módulos (mantener para compatibilidad):
QUEUE_BULL_REDIS_HOST=localhost
QUEUE_BULL_REDIS_PORT=6379

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BUCKET=whatsapp-media

# ─── Chatwoot ────────────────────────────────────────────────────────────────
# Base URL de tu instancia de Chatwoot (sin barra final).
CHATWOOT_API_URL=https://chatwoot.tudominio.com

# API access token de Chatwoot (perfil → Access Token).
CHATWOOT_API_KEY=replace-me

# ID numérico de la cuenta en Chatwoot (aparece en la URL: /app/accounts/{id}).
CHATWOOT_ACCOUNT_ID=1
