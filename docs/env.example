# Canal privado de avisos operativos de riesgo por WhatsApp.
# Definir estos valores solo en las variables del servidor (por ejemplo, Railway).
# No copiar números reales, identificadores privados ni tokens al repositorio.
# Sin las cuatro variables obligatorias, el canal de WhatsApp queda deshabilitado;
# la pausa preventiva y la alerta del panel siguen funcionando.
RISK_ALERT_WHATSAPP_TO=
RISK_ALERT_WHATSAPP_PHONE_NUMBER_ID=
RISK_ALERT_WHATSAPP_TEMPLATE_NAME=alerta_seguridad_campana
RISK_ALERT_WHATSAPP_LANGUAGE=es_AR

# Opcional: fija la identidad remota exacta de la plantilla dentro de la WABA.
# El trabajador siempre verifica UTILITY, APPROVED, salud y contenido fijo.
RISK_ALERT_WHATSAPP_TEMPLATE_ID=
